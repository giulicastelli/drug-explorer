%% Architecture: boxes inside the dashed line are containers; arrows go the way data moves; labels say what moves.
flowchart LR
    fda["OUTSIDE<br/>openFDA<br/>api.fda.gov, download.open.fda.gov"]
    raw[("./data/raw on the host<br/>14 zip files, 1.86 GB<br/>cache, never in git")]
    clean[("./data/clean on the host<br/>the extract: one CSV<br/>never in git")]
    browser["USER<br/>browser on the host"]

    subgraph compose ["docker compose up"]
        loader["loader<br/>Python, one-shot<br/>download, stream-parse (ijson), clean, COPY<br/>GIN index, drugs table<br/>atlas: TF-IDF, SVD, t-SNE, k-means"]
        db[("db<br/>PostgreSQL 16<br/>labels (+ tsvector, GIN index)<br/>drugs, atlas, atlas_regions, atlas_neighbours<br/>pipeline_timings, load_info")]
        app["app<br/>Streamlit<br/>tabs: Atlas, Top ingredients, About"]
    end

    vol[("dbdata<br/>named volume")]

    fda -- "download.json + 14 zip files<br/>over HTTPS" --> loader
    loader <-- "zip files, saved once,<br/>parsed only when no extract matches" --> raw
    clean <-- "kept rows: written after a parse,<br/>read on later starts" --> loader
    loader -- "rows (COPY), atlas points<br/>+ SQL that builds the index and drugs" --> db
    db <-- "data files" --> vol
    app -- "SQL queries<br/>(condition typed by the user, clicked ingredient)" --> db
    db -- "result rows<br/>(top ingredients, labels, map points, neighbours)" --> app
    app -- "web page<br/>localhost:8501" --> browser

    style compose fill:none,stroke:#555,stroke-width:2px,stroke-dasharray: 6 4
